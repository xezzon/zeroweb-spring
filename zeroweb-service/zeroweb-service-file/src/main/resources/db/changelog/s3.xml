<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
  http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="101" author="xezzon" labels="0.7">
    <createTable tableName="zeroweb_s3_upload_id" ifNotExists="true">
      <column name="attachment_id" type="VARCHAR(64)" remarks="附件ID">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="upload_id" type="VARCHAR(512)" remarks="S3上传ID">
        <constraints nullable="false"/>
      </column>
      <column name="crc" type="VARCHAR(64)" remarks="循环冗余校验和">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>
</databaseChangeLog>
